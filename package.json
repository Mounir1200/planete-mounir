{
  "name": "planete-mounir",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "build": "node scripts/build-wasm.mjs && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test qa/*.test.mjs",
